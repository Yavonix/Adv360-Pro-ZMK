#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      // Base top row:  # ! + = $ % ^ & * ( ) -
      // With Shift:   @ 1 2 3 4 5 6 7 8 9 0 _
      // Mask either held Shift for the second binding so digits stay unshifted.
      hash_at: hash_at {
          compatible = "zmk,behavior-mod-morph";
          label = "HASH_AT";
          #binding-cells = <0>;
          bindings = <&kp HASH>, <&kp AT>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym1: symbol_one {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_ONE";
          #binding-cells = <0>;
          bindings = <&kp EXCL>, <&kp N1>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym2: symbol_two {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_TWO";
          #binding-cells = <0>;
          bindings = <&kp PLUS>, <&kp N2>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym3: symbol_three {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_THREE";
          #binding-cells = <0>;
          bindings = <&kp EQUAL>, <&kp N3>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym4: symbol_four {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_FOUR";
          #binding-cells = <0>;
          bindings = <&kp DLLR>, <&kp N4>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym5: symbol_five {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_FIVE";
          #binding-cells = <0>;
          bindings = <&kp PRCNT>, <&kp N5>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym6: symbol_six {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_SIX";
          #binding-cells = <0>;
          bindings = <&kp CARET>, <&kp N6>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym7: symbol_seven {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_SEVEN";
          #binding-cells = <0>;
          bindings = <&kp AMPS>, <&kp N7>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym8: symbol_eight {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_EIGHT";
          #binding-cells = <0>;
          bindings = <&kp ASTRK>, <&kp N8>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym9: symbol_nine {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_NINE";
          #binding-cells = <0>;
          bindings = <&kp LPAR>, <&kp N9>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
      sym0: symbol_zero {
          compatible = "zmk,behavior-mod-morph";
          label = "SYMBOL_ZERO";
          #binding-cells = <0>;
          bindings = <&kp RPAR>, <&kp N0>;
          mods = <(MOD_LSFT | MOD_RSFT)>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &hash_at  &sym1     &sym2    &sym3    &sym4      &sym5  &tog 1                                                           &mo 3 &sym6  &sym7  &sym8     &sym9    &sym0    &kp MINUS
        &kp TAB   &kp B     &kp L    &kp D    &kp C      &kp V  &tog 4                                                            &none &kp J  &kp F  &kp O     &kp U    &kp COMMA    &kp BSLH
        &kp ESC   &kp N     &kp R    &kp T    &kp S      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp Y  &kp H  &kp A     &kp E    &kp I &kp SQT
        &kp LSHFT &kp Q     &kp X    &kp M    &kp W      &kp Z                            &kp HOME &kp PG_UP                           &kp K  &kp P  &kp SEMI &kp DOT  &kp FSLH &kp RSHFT
        &mo 2 &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    keypad {
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
        &kp TAB   &kp Q     &kp W    &kp E    &kp R      &kp T  &none                                                            &none &kp Y  &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
        &kp ESC   &kp A     &kp S    &kp D    &kp F      &kp G  &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
        &kp LSHFT &kp Z     &kp X    &kp C    &kp V      &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0              &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
      >;
    };
    fn {
      bindings = <
        &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog 1                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &trans &trans &trans &trans &trans &trans  &none                                           &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans  &none        &trans &trans &trans &trans        &none &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans &trans                      &trans &trans                     &trans &trans &trans &trans  &trans  &trans
        &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans              &trans &trans &trans  &trans  &trans
      >;
    };
    mod {
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none        &none        &none                   &none &none &bt BT_CLR &none                      &rgb_ug RGB_MEFS_CMD 5 &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver   &none                                      &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &none                                       &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    gaming {
      bindings = <
        &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4     &kp N5 &trans                                                           &mo 3 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp T &kp Q     &kp W    &kp E    &kp R        &trans                                                            &none &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
        &kp ESC   &kp G &kp A     &kp S    &kp D    &kp F       &none           &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
        &kp LSHFT &kp B &kp Z     &kp X    &kp C    &kp V                                 &kp HOME &kp PG_UP                           &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
        &mo 2     &kp GRAVE &kp CAPS &kp LEFT &kp RIGHT                &kp SPACE &kp ENTER &kp END  &kp PG_DN &kp BSPC &kp DEL             &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
  };
};


